    "devops": "reasoning",
    "researcher": "reasoning",
    "general": "light"
  },
  "namePrefixDefaults": {
    "00 AIA": "light",
    "01 CSO": "reasoning",
    "02 CPO": "light",
    "02 UID": "light",
    "02 UXW": "light",
    "02 WPM": "light",
    "03 CRO": "light",
    "04 COO": "light",
