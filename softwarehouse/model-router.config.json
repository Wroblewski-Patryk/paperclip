  "titleKeywordRules": [
    {
      "profile": "reasoning",
      "keywords": [
        "architecture",
        "security",
        "secrets",
        "deployment",
        "vps",
        "coolify",
        "schema",
        "migration",
        "cross-system",
        "multi-system",
        "production"
      ],
      "reason": "task touches architecture, security, deployment, data model, or production readiness"
    },
    {
      "profile": "light",
      "keywords": [
        "typo",
        "format",
        "formatting",
        "comment",
        "docs",
        "documentation",
        "readme",
        "status",
        "summary",
        "triage",
        "log"
      ],
      "priority": ["medium", "low"],
      "reason": "task appears lightweight and safe for the light lane"
    }
  ],
  "contextKeywordRules": [
    {
      "profile": "cheap",
      "keywords": ["status_only", "recovery", "liveness", "janitor"],
      "reason": "wake context is status/recovery oriented"
    }
  ],
  "escalationPolicy": {
    "order": ["cheap", "light", "standard", "reasoning", "strategic"],
    "conditions": [
      "task scope expands beyond the assigned bounded operation",
      "requirements or evidence remain materially ambiguous",
      "the current lane produces one failed implementation attempt",
      "work crosses repositories, systems, or production boundaries",
      "security, destructive data, secrets, deployment, or final release decisions are involved"
    ],
    "terraToSolAfterFailedAttempts": 2,
    "maximumAutomaticProfile": "strategic"
  },
  "quotaPressureFallbacks": {
    "high": {
      "strategic": "reasoning",
      "reasoning": "standard",
      "standard": "light",
      "light": "cheap",
      "spark": "cheap"
    },
    "critical": {
      "cheap": "cheap",
      "strategic": "standard",
      "reasoning": "light",
      "standard": "light",
      "light": "cheap",
      "spark": "cheap"
    }
  }
}
