    "05 CCO": "light",
    "05 CSM": "light",
    "06 AIM": "light",
    "06 CHRO": "light",
    "06 POP": "light",
    "07 CFO": "light",
    "08 CAO": "light",
    "09 CTO": "strategic",
    "09 TSA": "strategic",
    "09 EDL": "standard",
    "09 CBE": "standard",
    "09 FEW": "standard",
    "09 DBE": "standard",
    "09 IDE": "standard",
    "09 RTE": "standard",
    "09 TAE": "standard",
    "09 QVE": "standard",
    "09 CRS": "standard",
    "09 DRE": "reasoning",
